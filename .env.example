# Copiá este archivo a ".env" y completá los valores. NO subas ".env" a git.

PORT=8080

# Base de datos MySQL (ej. MAMP: host localhost, puerto 8889)
DB_HOST=localhost
DB_PORT=8889
DB_NAME=nombre_de_tu_base
DB_USER=root
DB_PASS=

# Clave para firmar los JWT. Usá una cadena larga y aleatoria (mínimo 32 caracteres).
# Generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# --- Opcionales (tienen valor por defecto) ---
# Duración del token (formato de la librería "ms": 15m, 1h, 7d)
JWT_EXPIRES_IN=1h
# Orígenes del frontend permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# true/false. Por defecto es true en desarrollo y false si NODE_ENV=production
# (crea/ajusta las tablas automáticamente a partir de las entidades)
DB_SYNC=true
